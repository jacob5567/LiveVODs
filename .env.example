# Twitch — https://dev.twitch.tv/console/apps
# Client-credentials grant; no user ever logs in.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# YouTube — https://console.cloud.google.com, enable "YouTube Data API v3"
YOUTUBE_API_KEY=

# Where the SQLite file lives. The worker is the only writer.
DATABASE_PATH=./data/livevods.db

# Extra domains allowed to host the Twitch embed. The hostname you browse from is
# detected and included automatically, so leave this blank unless the page is
# reachable under a name the browser does not report (a reverse proxy, or the
# guide embedded in another site).
#
# Note: Twitch requires HTTPS on any embedding domain other than localhost. Served
# over plain HTTP from a real hostname or a LAN IP, the player refuses to start.
TWITCH_EMBED_PARENTS=
