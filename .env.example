# Twitch — https://dev.twitch.tv/console/apps
# Client-credentials grant; no user ever logs in.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# YouTube — https://console.cloud.google.com, enable "YouTube Data API v3"
YOUTUBE_API_KEY=

# Where the SQLite file lives. The worker is the only writer.
DATABASE_PATH=./data/livevods.db

# Domains allowed to host the Twitch embed. MUST include the host you browse from,
# and Twitch requires SSL on any non-localhost domain.
TWITCH_EMBED_PARENTS=localhost

# Set only when this instance is reachable at a public HTTPS URL. Enables push
# ingest (EventSub webhooks + YouTube WebSub) instead of polling. Leave blank to poll.
PUBLIC_URL=
